---
interface Props {
    src: string[];
    alt: string;
    class?: string;
}
const { src, alt, class: className } = Astro.props as Props;
---

<div class={`flex gap-2 overflow-x-auto -mx-4 px-4 ${className}`}>
    {
        src.map((item) => (
            <img
                src={item}
                alt={alt}
                class="w-full aspect-square object-cover rounded-2xl"
            />
        ))
    }
</div>

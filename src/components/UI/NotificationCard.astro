---
import Title from "./Title.astro";

interface Props {
    title: string;
    date: string;
    description: string;
    unread?: boolean;
    dataSheetOpen?: string;
    dataModalOpen?: string;
}

const {
    title,
    date,
    description,
    unread = false,
    dataSheetOpen,
    dataModalOpen,
} = Astro.props as Props;
---

<button
    class="bg-card p-4 rounded-2xl grid gap-2 relative text-left"
    {...dataSheetOpen ? { "data-sheet-open": dataSheetOpen } : {}}
    {...dataModalOpen ? { "data-modal-open": dataModalOpen } : {}}
>
    <span class="text-medium">{date}</span>
    <Title as="h5">{title}</Title>
    <p>{description}</p>
    {
        unread && (
            <div class="w-2 h-2 rounded-full bg-primary absolute top-4 right-4" />
        )
    }
</button>

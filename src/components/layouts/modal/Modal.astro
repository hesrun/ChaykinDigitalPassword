---
import { X } from "@lucide/astro";

interface Props {
    id: string;
    closeButton?: boolean;
}

const { id, closeButton = true } = Astro.props;
---

<div class="modal" data-modal-id={id}>
    <div class="modal__backdrop" data-modal-backdrop></div>
    <div
        class="modal__content"
        data-modal-panel
        role="dialog"
        aria-modal="true"
    >
        {
            closeButton && (
                <button class="modal__close-button" data-modal-close={id}>
                    <X stroke-width={1} />
                </button>
            )
        }
        <slot />
    </div>
</div>

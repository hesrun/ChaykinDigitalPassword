---
import BottomSheet from "../layouts/bottomSheet/BottomSheet.astro";
import SheetContainer from "../layouts/bottomSheet/SheetContainer.astro";
import SheetHeader from "../layouts/bottomSheet/SheetHeader.astro";
import Button from "../UI/Button.astro";
import Title from "../UI/Title.astro";
import Textarea from "../UI/Textarea.astro";
import Select from "../UI/Select.astro";
import Input from "../UI/Input.astro";
---

<BottomSheet id="serviceOrder">
    <SheetContainer>
        <SheetHeader>
            <Title>Записаться на сервис</Title>
        </SheetHeader>
        <div class="grid gap-2">
            <Select
                id="typeService"
                name="typeService"
                label="Тип обращения"
                options={[
                    { value: "warranty", label: "Гарантийный ремонт" },
                    { value: "service", label: "Ремонт" },
                    { value: "consultation", label: "Консультация" },
                ]}
            />
            <Textarea
                placeholder="Текст комментария"
                name="comment"
                id="comment"
            />
            <Button variant="primary">Отправить запрос</Button>
        </div>
    </SheetContainer>
</BottomSheet>

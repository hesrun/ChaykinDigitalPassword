---
import { Mail, MessagesSquare, PhoneCall } from "@lucide/astro";
import BottomSheet from "../layouts/bottomSheet/BottomSheet.astro";
import SheetContainer from "../layouts/bottomSheet/SheetContainer.astro";
import SheetHeader from "../layouts/bottomSheet/SheetHeader.astro";
import Button from "../UI/Button.astro";
import Title from "../UI/Title.astro";
---

<BottomSheet id="ClientServiceSheet">
    <SheetContainer>
        <SheetHeader>
            <Title>Клиентский сервис</Title>
        </SheetHeader>
        <div class="grid gap-2">
            <Button variant="secondary" href="tel:+1234567890">
                Позвонить
                <PhoneCall
                    name="icon"
                    stroke-width={1}
                    class="text-primary ml-auto"
                />
            </Button>
            <Button variant="secondary" href="mailto:example@example.com">
                Написать письмо
                <Mail
                    name="icon"
                    stroke-width={1}
                    class="text-primary ml-auto"
                />
            </Button>
            <Button variant="secondary" href="tel:+1234567890">
                Написать в чат
                <MessagesSquare
                    name="icon"
                    stroke-width={1}
                    class="text-primary ml-auto"
                />
            </Button>
            <div class="grid gap-2 grid-cols-2">
                <Button variant="secondary" href="tel:+1234567890">
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"

---
import { Mail, MessagesSquare, PhoneCall } from "@lucide/astro";
import BottomSheet from "../layouts/bottomSheet/BottomSheet.astro";
import SheetContainer from "../layouts/bottomSheet/SheetContainer.astro";
import SheetHeader from "../layouts/bottomSheet/SheetHeader.astro";
import Button from "../UI/Button.astro";
import Title from "../UI/Title.astro";
import Radio from "../UI/Radio.astro";
import Textarea from "../UI/Textarea.astro";
---

<BottomSheet id="statusNotification">
    <SheetContainer>
        <SheetHeader>
            <Title>Статус и забота</Title>
        </SheetHeader>
        <div class="grid gap-4">
            <p>
                Владение подтверждено. Спасибо. Хотите обновить информацию о
                текущем состоянии механизма для архива мануфактуры?
            </p>
            <div class="flex gap-4 items-center">
                <img class="w-20" src="/img/add/watch-big.png" alt="" />
                <div class="grid gap-1">
                    <Title as="h4">Joker </Title>
                    <span>Ристмоны</span>
                    <div class="flex gap-2">
                        <span class="text-medium">Серийный номер:</span> KC-042
                    </div>
                </div>
            </div>
            <div class="bg-card p-4 rounded-2xl grid gap-4">
                <Title as="h6">Механика</Title>
                <div class="grid gap-3">
                    <Radio
                        id="mechanicalGood"
                        name="mechanicalStatus"
                        title="Идеально"
                        description="Точность хода и функции в норме"
                    />
                    <Radio
                        id="mechanicalIssues"
                        name="mechanicalStatus"
                        title="Есть замечания"
                        description="Небольшая погрешность хода или завода"
                    />
                    <Radio
                        id="mechanicalAttention"
                        name="mechanicalStatus"
                        title="Требует внимания"
                        description="Остановка механизма, повреждения или сбой функций"
                    />
                </div>
            </div>
            <div class="bg-card p-4 rounded-2xl grid gap-4">
                <Title as="h6">Как часто вы надеваете эти часы?</Title>
                <div class="grid gap-3">
                    <Radio
                        id="useRegularly"
                        name="useStatus"
                        title="Регулярно"
                        description="Несколько раз в неделю"
                    />
                    <Radio
                        id="useOccasionally"
                        name="useStatus"
                        title="По случаю"
                        description="Несколько раз в месяц"
                    />
                    <Radio
                        id="useStorage"
                        name="useStatus"
                        title="Хранение"
                        description="Редко или не ношу"
                    />
                </div>
            </div>
            <div class="bg-card p-4 rounded-2xl grid gap-4">
                <Title as="h6">Комментарий (опционально)</Title>
                <Textarea
                    placeholder="Хотите сообщить что-то мастеру?"
                    name="comment"
                    id="comment"
                    class="bg-white"
                />
            </div>
            <div class="grid gap-2">
                <Button>Отправить</Button>
                <Button variant="secondary">Пропустить</Button>
            </div>
        </div>
    </SheetContainer>
</BottomSheet>

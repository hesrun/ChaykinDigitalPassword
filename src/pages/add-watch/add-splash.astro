---
import Title from "@components/UI/Title.astro";
import ScreenLayout from "@layouts/ScreenLayout.astro";
import AddWatchExist from "@src/components/modals/addWatchExist.astro";
import AddWatchIdentification from "@src/components/modals/addWatchIdentification.astro";
import AddWatchKidnap from "@src/components/modals/addWatchKidnap.astro";
---

<ScreenLayout>
    <video
        class="fixed inset-0 object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
    >
        <source src="/video/splash.mp4" type="video/mp4" />
    </video>
    <div
        class="fixed inset-0 flex flex-col items-center justify-center text-white"
    >
        <div class="w-60">
            <svg
                class="mb-5 mx-auto"
                width="98"
                height="54"
                viewBox="0 0 98 54"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M33.6875 51L30.625 54H67.375L64.3125 51L61.25 48H49L0 0L49 36L98 0L49 48H36.75L33.6875 51Z"
                    fill="white"></path>
            </svg>
            <Title as="h3" class="text-center"
                >Связь с архивом <br /> мануфактуры</Title
            >
            <div
                class="h-1.5 bg-white/10 rounded-full mt-5 mb-3 overflow-hidden backdrop-blur-2xl"
            >
                <div class="h-full bg-white rounded-2xl animate-loader w-1/2">
                </div>
            </div>
        </div>
        <span
            class="w-60 absolute bottom-14 font-roboto roboto-flex-custom text-center font-semibold"
            >Ищем ваши часы в базе данных</span
        >
    </div>
</ScreenLayout>
<AddWatchIdentification />
<AddWatchExist />
<AddWatchKidnap />
<script>
    setTimeout(() => {
        Modal.open("add-watch-ident");
    }, 2000);
    setTimeout(() => {
        Modal.open("add-watch-exist");
    }, 3000);
    setTimeout(() => {
        Modal.open("add-watch-kidnap");
    }, 4000);
</script>

---
import ScreenBody from "@components/layouts/ScreenBody.astro";
import ScreenLayout from "@layouts/ScreenLayout.astro";
import NavBar from "@components/layouts/NavBar.astro";
import Header from "@src/components/layouts/header/Header.astro";
import FooterLayout from "@src/components/layouts/footer/FooterLayout.astro";
import Button from "@src/components/UI/Button.astro";
import Textarea from "@src/components/UI/Textarea.astro";
import Input from "@src/components/UI/Input.astro";
---

<ScreenLayout>
    <Header title="Написать письмо" backUrl="/settings" />
    <ScreenBody hasNavbr>
        <div class="grid gap-2">
            <Input
                variant="floating"
                type="text"
                placeholder="Тема"
                label="Тема"
                name="subject"
                inputmode="text"
            />
            <Textarea
                placeholder="Текст комментария"
                id="comment"
                name="comment"
            />
        </div>
        <FooterLayout>
            <Button> Отправить </Button>
        </FooterLayout>
    </ScreenBody>

    <NavBar active="settings" />
</ScreenLayout>

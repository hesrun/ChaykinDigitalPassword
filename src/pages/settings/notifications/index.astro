---
import ScreenBody from "@components/layouts/ScreenBody.astro";
import ScreenLayout from "@layouts/ScreenLayout.astro";
import NavBar from "@components/layouts/NavBar.astro";
import HeaderLayout from "@src/components/layouts/header/HeaderLayout.astro";
import Header from "@src/components/layouts/header/Header.astro";
import FooterLayout from "@src/components/layouts/footer/FooterLayout.astro";
import Button from "@src/components/UI/Button.astro";
import Toggle from "@src/components/UI/Toggle.astro";
---

<ScreenLayout>
    <HeaderLayout>
        <Header title="Уведомления" backUrl="/settings" />
    </HeaderLayout>
    <ScreenBody hasNavbr>
        <div class="grid gap-6">
            <div class="grid gap-2">
                <Toggle
                    id="push-service"
                    name="push-service"
                    label="Сервисные уведомления"
                />
                <span class="text-medium"
                    >Статус ремонта, гарантия, безопасность</span
                >
            </div>
            <div class="grid gap-2">
                <Toggle
                    id="push-access"
                    name="push-access"
                    label="Access и Приглашения"
                />
                <span class="text-medium"
                    >Приглашения на мероприятия и релизы новинок</span
                >
            </div>
        </div>
        <FooterLayout>
            <Button> Сохранить </Button>
        </FooterLayout>
    </ScreenBody>

    <NavBar active="settings" />
</ScreenLayout>

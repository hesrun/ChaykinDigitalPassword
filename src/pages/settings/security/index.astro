---
import ScreenBody from "@components/layouts/ScreenBody.astro";
import ScreenLayout from "@layouts/ScreenLayout.astro";
import NavBar from "@components/layouts/NavBar.astro";
import Header from "@src/components/layouts/header/Header.astro";
import FooterLayout from "@src/components/layouts/footer/FooterLayout.astro";
import Button from "@src/components/UI/Button.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { ScanFace, Lock } from "@lucide/astro";
import CardButton from "@src/components/UI/CardButton.astro";
import Toggle from "@src/components/UI/Toggle.astro";

type SecurityButton = {
    title: string;
    href?: string;
    type: "link" | "button" | "div";
    size?: "small" | "medium";
    icon: AstroComponentFactory;
    toggle?: boolean;
};

const security: SecurityButton[] = [
    {
        title: "Сменить PIN-код",
        href: "/sign/signinCode",
        type: "link",
        icon: Lock,
        size: "medium",
    },
    {
        title: "Face ID",
        type: "div",
        icon: ScanFace,
        size: "medium",
        toggle: true,
    },
];
---

<ScreenLayout>
    <Header title="Безопасность" backUrl="/settings" />
    <ScreenBody hasNavbr>
        <div class="grid grid-cols-2 gap-2">
            {
                security.map((button) => (
                    <CardButton
                        title={button.title}
                        type={button.type}
                        icon={button.icon}
                        {...(button.href ? { href: button.href } : {})}
                    >
                        {button.toggle && (
                            <div slot="toggle">
                                <Toggle id="faceID" name="faceId" />
                            </div>
                        )}
                    </CardButton>
                ))
            }
        </div>
        <FooterLayout>
            <Button> Сохранить </Button>
        </FooterLayout>
    </ScreenBody>

    <NavBar active="settings" />
</ScreenLayout>

---
import ScreenBody from "@components/layouts/ScreenBody.astro";
import ScreenLayout from "@layouts/ScreenLayout.astro";
import NavBar from "@components/layouts/NavBar.astro";
import HeaderLayout from "@src/components/layouts/header/HeaderLayout.astro";
import Header from "@src/components/layouts/header/Header.astro";
import CardButton, {
    type CardButtonProps,
} from "@src/components/UI/CardButton.astro";
import { Bell, LogOut, PhoneCall, ShieldCheck, UserRound } from "@lucide/astro";
import ClientServiceSheet from "@src/components/sheets/ClientServiceSheet.astro";

const settingsButtons: CardButtonProps[] = [
    {
        title: "Личные данные",
        href: "/settings/personal",
        type: "link",
        icon: UserRound,
        size: "medium",
    },
    {
        title: "Безопасность",
        href: "/settings/security",
        type: "link",
        icon: ShieldCheck,
        size: "medium",
    },
    {
        title: "Настройки уведомлений",
        href: "/settings/notifications",
        type: "link",
        icon: Bell,
        size: "medium",
    },
    {
        title: "Связаться с консьержем",
        type: "button",
        icon: PhoneCall,
        size: "medium",
        dataSheetOpen: "ClientServiceSheet",
    },
];

const textLinks = [
    {
        title: "Удалить аккаунт",
        href: "#",
    },
    {
        title: "Политика конфиденциальности",
        href: "settings/info/privacy",
    },
    {
        title: "Пользовательское соглашение",
        href: "settings/info/terms",
    },
    {
        title: "О приложении / Версия 1.0.2 (Build 45)",
        href: "settings/info/about",
    },
];
---

<ScreenLayout>
    <HeaderLayout>
        <Header title="Настройки" />
    </HeaderLayout>
    <ScreenBody hasNavbr>
        <div class="grid grid-cols-2 gap-2">
            {
                settingsButtons.map((button) => (
                    <CardButton
                        title={button.title}
                        type={button.type}
                        icon={button.icon}
                        {...(button.href ? { href: button.href } : {})}
                        dataSheetOpen={button.dataSheetOpen}
                    />
                ))
            }
        </div>
        <a
            href="/"
            class="flex items-center gap-2 text-medium active:text-primary mt-4"
        >
            <LogOut stroke-width={1} />
            Выйти
        </a>
        <div class="mt-auto grid gap-1 text-medium">
            {
                textLinks.map((link) => (
                    <a href={link.href} class="active:text-primary">
                        {link.title}
                    </a>
                ))
            }
        </div>
    </ScreenBody>
</ScreenLayout>
<NavBar active="settings" />
<ClientServiceSheet />
